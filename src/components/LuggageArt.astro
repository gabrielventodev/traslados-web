---
// Ilustración vectorial (nítida en cualquier pantalla) de valijas en la playa.
---
<svg class="luggage-art" viewBox="0 0 560 420" role="img" aria-labelledby="lug-t">
  <title id="lug-t">Valijas de colores listas para viajar, frente al mar</title>
  <defs>
    <linearGradient id="lg-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7fb6f2"/><stop offset="1" stop-color="#d9ecff"/></linearGradient>
    <linearGradient id="lg-sea" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2aa6c9"/><stop offset="1" stop-color="#7fd6e2"/></linearGradient>
    <linearGradient id="lg-sand" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f6e2b8"/><stop offset="1" stop-color="#ecd09a"/></linearGradient>
    <linearGradient id="lg-shine" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fff" stop-opacity=".35"/><stop offset=".4" stop-color="#fff" stop-opacity="0"/></linearGradient>
    <clipPath id="lg-clip"><rect width="560" height="420" rx="20"/></clipPath>
  </defs>
  <g clip-path="url(#lg-clip)">
    <rect width="560" height="420" fill="url(#lg-sky)"/>
    <circle cx="470" cy="70" r="34" fill="#fff4c2"/>
    <circle cx="470" cy="70" r="52" fill="#fff4c2" opacity=".35"/>
    <g fill="#fff" opacity=".9"><ellipse cx="110" cy="70" rx="56" ry="16"/><ellipse cx="150" cy="58" rx="36" ry="18"/><ellipse cx="320" cy="100" rx="60" ry="13"/><ellipse cx="350" cy="90" rx="30" ry="14"/></g>
    <path d="M330 52l26 6-26 6-6 10-5-1 3-10-14-3-4 5h-4l2-7-2-7h4l4 5 14-3-3-10 5-1z" fill="#1d5bd0" opacity=".7"/>
    <rect y="200" width="560" height="70" fill="url(#lg-sea)"/>
    <path d="M0 262c60-12 120 10 180 0s120-14 190-2 130 10 190-2v30H0z" fill="#fff" opacity=".7"/>
    <path d="M0 268c70-10 130 14 200 4s130-14 200-2 110 8 160 0v150H0z" fill="url(#lg-sand)"/>
    <ellipse cx="300" cy="392" rx="230" ry="16" fill="#c9a86a" opacity=".45"/>

    <!-- valija azul grande -->
    <g>
      <path d="M150 96v-36h46v36" fill="none" stroke="#3b4658" stroke-width="7" stroke-linejoin="round"/>
      <rect x="124" y="94" width="98" height="282" rx="16" fill="#2f7fe0"/>
      <rect x="124" y="94" width="98" height="282" rx="16" fill="url(#lg-shine)"/>
      <path d="M146 112v246M173 112v246M200 112v246" stroke="#1f5fb4" stroke-width="4" opacity=".55"/>
      <circle cx="140" cy="384" r="9" fill="#26303f"/><circle cx="206" cy="384" r="9" fill="#26303f"/>
    </g>
    <!-- valija verde -->
    <g>
      <path d="M392 120v-40h40v40" fill="none" stroke="#3b4658" stroke-width="7" stroke-linejoin="round"/>
      <rect x="366" y="118" width="92" height="256" rx="16" fill="#36a852"/>
      <rect x="366" y="118" width="92" height="256" rx="16" fill="url(#lg-shine)"/>
      <path d="M388 136v222M412 136v222M436 136v222" stroke="#23813c" stroke-width="4" opacity=".55"/>
      <circle cx="382" cy="382" r="9" fill="#26303f"/><circle cx="442" cy="382" r="9" fill="#26303f"/>
    </g>
    <!-- valija naranja -->
    <g>
      <path d="M268 150v-44h44v44" fill="none" stroke="#3b4658" stroke-width="7" stroke-linejoin="round"/>
      <rect x="238" y="148" width="104" height="236" rx="16" fill="#f59a23"/>
      <rect x="238" y="148" width="104" height="236" rx="16" fill="url(#lg-shine)"/>
      <path d="M262 166v202M290 166v202M318 166v202" stroke="#d07a0c" stroke-width="4" opacity=".55"/>
      <circle cx="254" cy="392" r="9" fill="#26303f"/><circle cx="326" cy="392" r="9" fill="#26303f"/>
    </g>
    <!-- valija azul marino chica -->
    <g>
      <path d="M470 226v-30h30v30" fill="none" stroke="#3b4658" stroke-width="6" stroke-linejoin="round"/>
      <rect x="448" y="224" width="76" height="156" rx="14" fill="#23407e"/>
      <rect x="448" y="224" width="76" height="156" rx="14" fill="url(#lg-shine)"/>
      <path d="M467 240v124M486 240v124M505 240v124" stroke="#162c5c" stroke-width="3.5" opacity=".6"/>
      <circle cx="462" cy="386" r="8" fill="#26303f"/><circle cx="510" cy="386" r="8" fill="#26303f"/>
    </g>
    <!-- sombrero de paja -->
    <g transform="translate(96 300) rotate(-14)">
      <ellipse cx="0" cy="26" rx="70" ry="18" fill="#e3b55f"/>
      <path d="M-36 24c0-34 16-48 36-48s36 14 36 48z" fill="#edc677"/>
      <path d="M-35 14h70v10h-70z" fill="#1d5bd0"/>
    </g>
    <!-- estrella de mar -->
    <path d="M352 372l7 15 16 2-12 11 3 16-14-8-14 8 3-16-12-11 16-2z" fill="#f08a5d"/>
    <!-- ojotas -->
    <g fill="#2fb5c9"><ellipse cx="420" cy="404" rx="22" ry="8"/><ellipse cx="470" cy="408" rx="22" ry="8"/></g>
  </g>
</svg>
<style>
  .luggage-art { width: 100%; height: auto; display: block; border-radius: 20px; box-shadow: var(--shadow); }
</style>
