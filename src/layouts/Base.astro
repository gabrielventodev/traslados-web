---
import '../styles/global.css';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import logo from '../assets/logo.jpg';
import { BUSINESS, SITE_URL, BASE, url, waLink, SERVICE_PAGES, ZONE_PAGES, GUIDE_PAGES } from '../data/site.js';

interface Crumb { name: string; path: string; }
interface Props {
  title: string;
  description: string;
  schema?: object[];
  crumbs?: Crumb[];
  ogImage?: string;
  noindex?: boolean;
}
const { title, description, schema = [], crumbs = [], ogImage = url('/og-traslados-aeropuerto.jpg'), noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogUrl = new URL(ogImage, SITE_URL).href;

const orgId = `${SITE_URL}/#negocio`;
const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': orgId,
  name: BUSINESS.name,
  slogan: BUSINESS.slogan,
  description: 'Traslados privados al Aeropuerto de Ezeiza y Aeroparque en Buenos Aires, en una van espaciosa para mucho equipaje y con rampa para personas en silla de ruedas.',
  url: `${SITE_URL}/`,
  logo: `${SITE_URL}/icon-512.png`,
  image: ogUrl,
  telephone: BUSINESS.phoneE164,
  priceRange: '$$',
  currenciesAccepted: 'ARS',
  address: { '@type': 'PostalAddress', addressLocality: BUSINESS.city, addressRegion: BUSINESS.region, addressCountry: BUSINESS.country },
  areaServed: [
    { '@type': 'City', name: 'Ciudad Autónoma de Buenos Aires' },
    { '@type': 'AdministrativeArea', name: 'Gran Buenos Aires' },
    { '@type': 'AdministrativeArea', name: 'Zona Norte del Gran Buenos Aires' },
    { '@type': 'AdministrativeArea', name: 'Zona Oeste del Gran Buenos Aires' },
    { '@type': 'AdministrativeArea', name: 'Zona Sur del Gran Buenos Aires' },
    { '@type': 'Airport', name: 'Aeropuerto Internacional Ministro Pistarini (Ezeiza)', iataCode: 'EZE' },
    { '@type': 'Airport', name: 'Aeroparque Internacional Jorge Newbery', iataCode: 'AEP' },
  ],
  knowsAbout: ['Traslados al aeropuerto', 'Transfer Ezeiza', 'Transfer Aeroparque', 'Transporte de personas en silla de ruedas', 'Van con rampa'],
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Rampa para silla de ruedas', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Espacio para mucho equipaje', value: true },
  ],
  contactPoint: { '@type': 'ContactPoint', telephone: BUSINESS.phoneE164, contactType: 'reservations', availableLanguage: ['es'] },
  sameAs: [],
};
const breadcrumbSchema = crumbs.length ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Inicio', path: url('/') }, ...crumbs].map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.path, SITE_URL).href,
  })),
} : null;
const allSchema = [business, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...schema];
const path = Astro.url.pathname.slice(BASE.length) || '/';
---
<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="claude:viewport-fit-sides" content="cover" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
  <meta name="theme-color" content="#0f2f6e" />
  <meta name="geo.region" content="AR-C" />
  <meta name="geo.placename" content="Buenos Aires" />
  <link rel="preload" href={url('/fonts/montserrat-latin-wght-italic.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={url('/fonts/figtree-latin-wght-normal.woff2')} as="font" type="font/woff2" crossorigin />
  <link rel="icon" href={url('/favicon-48.png')} sizes="48x48" type="image/png" />
  <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
  <link rel="manifest" href={url('/site.webmanifest')} />
  <link rel="sitemap" href={url('/sitemap-index.xml')} />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_AR" />
  <meta property="og:site_name" content={BUSINESS.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogUrl} />

  {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <a class="sr-only" href="#contenido">Saltar al contenido</a>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href={url('/')} aria-label={`${BUSINESS.name}, ir al inicio`}>
        <Image src={logo} alt="" width={92} height={92} loading="eager" />
        <span><strong>Traslados <span>Aeropuerto</span></strong><small>{BUSINESS.slogan}</small></span>
      </a>
      <nav class="nav" aria-label="Principal">
        <a href={url('/traslados-aeropuerto-ezeiza/')} aria-current={path.startsWith('/traslados-aeropuerto-ezeiza') ? 'page' : undefined}>Ezeiza</a>
        <a href={url('/traslados-aeroparque/')} aria-current={path.startsWith('/traslados-aeroparque') ? 'page' : undefined}>Aeroparque</a>
        <a href={url('/traslados-silla-de-ruedas/')} aria-current={path.startsWith('/traslados-silla-de-ruedas') ? 'page' : undefined}>Silla de ruedas</a>
        <a href={path === '/' ? '#reservar' : url('/#reservar')}>Cotizar</a>
        <a class="btn btn-wa" href={waLink()} rel="noopener" target="_blank"><Icon name="whatsapp" /><span>{BUSINESS.phoneDisplay}</span></a>
      </nav>
    </div>
  </header>

  <main id="contenido">
    <slot />
  </main>

  <section class="cta-band section" aria-labelledby="cta-title">
    <svg class="cta-art" viewBox="0 0 600 400" fill="none" preserveAspectRatio="xMaxYMid meet" aria-hidden="true" focusable="false">
      <path d="M-20 360 C 140 380, 220 120, 400 190 S 520 250, 560 60" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 14" />
      <g transform="translate(430 150) rotate(38) scale(9) translate(-12 -12)" fill="currentColor">
        <path d="M21.5 15.5v-2l-8-5V3a1.5 1.5 0 0 0-3 0v5.5l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5l-2-1.5v-6l8 2.5z"/>
      </g>
    </svg>
    <div class="wrap">
      <div class="cta-copy">
        <h2 id="cta-title">¿Tenés vuelo? Reservá tu traslado hoy.</h2>
        <p>Respondemos por WhatsApp y te confirmamos el precio antes de viajar.</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-wa" href={waLink()} rel="noopener" target="_blank"><Icon name="whatsapp" /> WhatsApp {BUSINESS.phoneDisplay}</a>
        <a class="btn btn-call" href={`tel:${BUSINESS.phoneE164}`}><Icon name="phone" /> Llamar</a>
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <a class="brand" href={url('/')}><Image src={logo} alt="" width={92} height={92} /><span><strong>Traslados <span>Aeropuerto</span></strong><small>{BUSINESS.slogan}</small></span></a>
          <p style="margin-top:14px">Traslados privados desde y hacia el Aeropuerto de Ezeiza y Aeroparque, en una van espaciosa que además tiene rampa para personas en silla de ruedas.</p>
        </div>
        <div>
          <h3>Servicios</h3>
          <ul>
            {SERVICE_PAGES.map((pg) => <li><a href={url(pg.path)}>{pg.name}</a></li>)}
            <li><a href={path === '/' ? '#preguntas' : url('/#preguntas')}>Preguntas frecuentes</a></li>
          </ul>
        </div>
        <div>
          <h3>Zonas y guías</h3>
          <ul>
            {ZONE_PAGES.map((pg) => <li><a href={url(pg.path)}>Traslados desde {pg.name}</a></li>)}
            <li><a href={url('/#zonas')}>Capital Federal</a></li>
            {GUIDE_PAGES.map((pg) => <li><a href={url(pg.path)}>{pg.short}</a></li>)}
          </ul>
        </div>
        <div>
          <h3>Contacto</h3>
          <ul>
            <li><a href={waLink()} rel="noopener" target="_blank">WhatsApp {BUSINESS.phoneDisplay}</a></li>
            <li><a href={`tel:${BUSINESS.phoneE164}`}>Llamar al {BUSINESS.phoneDisplay}</a></li>
            <li><p>Buenos Aires, Argentina</p></li>
          </ul>
        </div>
      </div>
      <div class="legal">
        <p>© {new Date().getFullYear()} {BUSINESS.name}. Todos los derechos reservados.</p>
        <p class="credit">Hecho por Gabriel Vento <a href="https://www.linkedin.com/in/gabrielventocunha/" target="_blank" rel="noopener" aria-label="LinkedIn de Gabriel Vento"><Icon name="linkedin" /></a></p>
      </div>
    </div>
  </footer>

  <a class="wa-float" href={waLink()} rel="noopener" target="_blank" aria-label={`Escribir por WhatsApp al ${BUSINESS.phoneDisplay}`}><Icon name="whatsapp" /></a>
  <script is:inline>
  (function () {
    // Navegación fiable: al cambiar de página arranca arriba, y los enlaces a secciones bajan hasta ellas.
    try { history.scrollRestoration = 'manual'; } catch (e) {}
    function go(id) {
      var el = id && document.getElementById(id);
      if (el) { el.scrollIntoView({ behavior: 'smooth', block: 'start' }); return true; }
      return false;
    }
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href*="#"]');
      if (!a || a.target === '_blank') return;
      var url = new URL(a.getAttribute('href'), location.href);
      var id = url.hash.slice(1);
      if (!id) return;
      if (url.pathname === location.pathname) { if (go(id)) e.preventDefault(); }
      else { try { sessionStorage.setItem('ir-a', id); } catch (err) {} }
    });
    function start() {
      var id = location.hash.slice(1);
      try { id = id || sessionStorage.getItem('ir-a'); sessionStorage.removeItem('ir-a'); } catch (err) {}
      if (!go(id)) window.scrollTo(0, 0);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start); else start();
  })();
  </script>
</body>
</html>
