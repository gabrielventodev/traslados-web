---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import BookingForm from '../components/BookingForm.astro';
import Faq from '../components/Faq.astro';
import FlightPath from '../components/FlightPath.astro';
import { SITE_URL, waLink } from '../data/site.js';

interface Props {
  title: string;
  description: string;
  crumb: string;
  eyebrow: string;
  h1: string;
  intro: string;
  image: ImageMetadata;
  imageAlt: string;
  facts: { label: string; value: string }[];
  faqs: { q: string; a: string }[];
  waText: string;
  preset: 'ezeiza' | 'aeroparque' | 'silla';
  serviceName: string;
}
const p = Astro.props;
const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: p.serviceName,
  serviceType: p.serviceName,
  description: p.description,
  provider: { '@id': `${SITE_URL}/#negocio` },
  areaServed: 'Buenos Aires, Argentina',
  url: new URL(Astro.url.pathname, SITE_URL).href,
};
---
<Base title={p.title} description={p.description} crumbs={[{ name: p.crumb, path: Astro.url.pathname }]} schema={[service]}>
  <section class="hero">
    <FlightPath />
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <nav class="crumbs" aria-label="Migas de pan"><ol><li><a href="/">Inicio</a></li><li aria-current="page">{p.crumb}</li></ol></nav>
        <span class="eyebrow">{p.eyebrow}</span>
        <h1>{p.h1}</h1>
        <p class="lead">{p.intro}</p>
        <div class="hero-ctas">
          <a class="btn btn-wa" href={waLink(p.waText)} rel="noopener" target="_blank"><Icon name="whatsapp" /> Reservar por WhatsApp</a>
          <a class="btn btn-ghost" href="#reservar">Cotizar mi viaje <span class="arr" aria-hidden="true"><Icon name="arrow-right" /></span></a>
        </div>
      </div>
      <div class="hero-media">
        <div class="photo"><Image src={p.image} alt={p.imageAlt} widths={[480, p.image.width]} sizes="(max-width: 860px) 100vw, 560px" loading="eager" fetchpriority="high" /></div>
        <div class="badge" aria-hidden="true">
          <span class="badge-ico"><Icon name="check" /></span>
          <span>Precio cerrado antes de viajar</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap" style="display:grid;gap:40px">
      <dl class="facts reveal">
        {p.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
      </dl>
      <div class="prose reveal"><slot /></div>
    </div>
  </section>

  <section class="section" id="reservar" aria-labelledby="reservar-title" style="padding-top:0">
    <div class="wrap"><BookingForm preset={p.preset} /></div>
  </section>

  <section class="section" aria-labelledby="faq-title" style="padding-top:0">
    <div class="wrap">
      <Faq items={p.faqs}>
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2 id="faq-title">Dudas sobre este traslado</h2>
      </Faq>
    </div>
  </section>
</Base>
