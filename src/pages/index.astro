---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Board from '../components/Board.astro';
import BookingForm from '../components/BookingForm.astro';
import Faq from '../components/Faq.astro';
import FlightPath from '../components/FlightPath.astro';
import { SITE_URL, url, waLink, ZONE_PAGES } from '../data/site.js';
import vans from '../assets/vans-avion.jpg';
import rampa from '../assets/rampa-silla.jpg';
import rampa2 from '../assets/rampa-silla-2.jpg';
import vanFrente from '../assets/van-frente.jpg';
import vanRampa from '../assets/van-rampa-trasera.jpg';
import equipaje from '../assets/equipaje.jpg';

const faqs = [
  { q: '¿Cuánto cuesta un traslado a Ezeiza o Aeroparque?', a: 'Depende del punto de partida, el horario y la cantidad de pasajeros. Escribinos por WhatsApp con la dirección y la fecha y te pasamos el precio cerrado antes de confirmar.' },
  { q: '¿Tienen vehículo para personas en silla de ruedas?', a: 'Sí. Nuestra van tiene rampa de acceso, para que la persona suba sin dejar la silla de ruedas, y espacio para un acompañante y el equipaje.' },
  { q: '¿Cuántas valijas entran en la van?', a: 'La van es espaciosa y está pensada para pasajeros con mucho equipaje. Contanos cuántas valijas llevan al reservar y te confirmamos que entra todo.' },
  { q: '¿Qué pasa si mi vuelo se atrasa?', a: 'Pasanos tu número de vuelo al reservar. Coordinamos el horario de retiro según la llegada real del vuelo para que no tengas que preocuparte.' },
  { q: '¿Con cuánta anticipación tengo que reservar?', a: 'Lo ideal es reservar con al menos 24 horas de anticipación, porque trabajamos con una sola van. Para viajes en el día consultanos por WhatsApp.' },
  { q: '¿Hacen traslados entre Ezeiza y Aeroparque?', a: 'Sí, hacemos la conexión entre ambos aeropuertos para quienes tienen un vuelo de cabotaje después de un vuelo internacional, y viceversa.' },
];

const services = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Traslados al aeropuerto',
  name: 'Traslados al Aeropuerto de Ezeiza y Aeroparque',
  provider: { '@id': `${SITE_URL}/#negocio` },
  areaServed: 'Buenos Aires, Argentina',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de traslado',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Traslado al Aeropuerto de Ezeiza (EZE)' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Traslado a Aeroparque Jorge Newbery (AEP)' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Traslado para personas en silla de ruedas en van con rampa' } },
    ],
  },
};
---
<Base
  title="Traslados al Aeropuerto Ezeiza y Aeroparque | Remis en van, Buenos Aires"
  description="Traslados privados a Ezeiza y Aeroparque en van espaciosa para mucho equipaje. Con rampa para personas en silla de ruedas. Reservá por WhatsApp 11 6621 1059."
  schema={[services]}
>
  <section class="hero hero-home">
    <FlightPath />
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Buenos Aires · Ezeiza · Aeroparque</span>
        <h1>Traslados al Aeropuerto <em>Ezeiza</em> y <em>Aeroparque</em></h1>
        <p class="lead">Te llevamos y te buscamos en una van espaciosa, con lugar para todas tus valijas. Y si viajás en silla de ruedas, la misma van tiene rampa para que subas sin bajarte de ella.</p>
        <div class="hero-ctas">
          <a class="btn btn-wa" href={waLink()} rel="noopener" target="_blank"><Icon name="whatsapp" /> Reservar por WhatsApp</a>
          <a class="btn btn-ghost" href="#reservar">Cotizar mi viaje <span class="arr" aria-hidden="true"><Icon name="arrow-right" /></span></a>
        </div>
      </div>
      <div class="hero-media collage">
        <div class="photo photo-main">
          <Image src={vans} alt="Van plateada de Traslados Aeropuerto frente a un avión en la pista" widths={[480, 853]} sizes="(max-width: 860px) 100vw, 560px" loading="eager" fetchpriority="high" />
        </div>
        <div class="photo photo-second">
          <Image src={rampa2} alt="Chofer ayudando a un pasajero en silla de ruedas a subir por la rampa de la van" widths={[280, 553]} sizes="(max-width: 860px) 45vw, 260px" />
        </div>
        <div class="pass" aria-hidden="true">
          <div class="pass-body">
            <div class="pass-head"><small>Vuelo</small><small>Puerta a puerta</small></div>
            <div class="pass-route">
              <span><b>EZE</b><small>Ezeiza</small></span>
              <span class="pass-line"><Icon name="plane" /></span>
              <span class="r"><b>AEP</b><small>Aeroparque</small></span>
            </div>
            <div class="pass-stub"><span class="barcode"></span><small>Traslado privado</small></div>
          </div>
        </div>
        <div class="badge" aria-hidden="true">
          <span class="badge-ico"><Icon name="check" /></span>
          <span>Precio cerrado antes de viajar</span>
        </div>
      </div>
    </div>
  </section>

  <section class="trust" aria-label="Beneficios del servicio">
    <div class="wrap">
      <ul class="trust-bar reveal">
        <li><span class="tile" aria-hidden="true"><Icon name="luggage" /></span><span><b>Van para mucho equipaje</b><small>Valijas, cochecitos y bolsos</small></span></li>
        <li><span class="tile" aria-hidden="true"><Icon name="wheelchair" /></span><span><b>Rampa para silla de ruedas</b><small>Subís sin bajarte de la silla</small></span></li>
        <li><span class="tile" aria-hidden="true"><Icon name="plane" /></span><span><b>Seguimos tu vuelo</b><small>Coordinamos según la llegada real</small></span></li>
        <li><span class="tile" aria-hidden="true"><Icon name="tag" /></span><span><b>Precio cerrado</b><small>Lo sabés antes de confirmar</small></span></li>
      </ul>
    </div>
  </section>

  <section class="board-band section" aria-labelledby="rutas-title">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Rutas frecuentes</span>
        <h2 id="rutas-title">Tablero de traslados</h2>
        <p class="lead">Viajes puerta a puerta entre los dos aeropuertos de Buenos Aires, Capital Federal y el Gran Buenos Aires.</p>
      </div>
      <Board />
    </div>
  </section>

  <section class="section" aria-labelledby="servicios-title">
    <div class="wrap">
      <div class="section-head center reveal">
        <span class="eyebrow">Servicios</span>
        <h2 id="servicios-title">Elegí tu traslado</h2>
      </div>
      <div class="cards">
        <article class="card reveal">
          <div class="card-media">
            <Image src={vanFrente} alt="Van plateada para traslados al Aeropuerto de Ezeiza" widths={[400, 433]} sizes="(max-width: 900px) 100vw, 370px" />
            <span class="tag" aria-hidden="true"><b>EZE</b></span>
          </div>
          <div class="card-body">
            <h3>Traslado a Ezeiza</h3>
            <p>Viajes al Aeropuerto Internacional Ministro Pistarini desde Capital y Gran Buenos Aires, ideal para vuelos internacionales con mucho equipaje.</p>
            <a href={url('/traslados-aeropuerto-ezeiza/')}>Ver traslados a Ezeiza <span class="arr" aria-hidden="true"><Icon name="arrow-right" /></span></a>
          </div>
        </article>
        <article class="card reveal">
          <div class="card-media">
            <Image src={vans} alt="Van de traslado junto a un avión en Aeroparque" widths={[480, 853]} sizes="(max-width: 900px) 100vw, 370px" />
            <span class="tag" aria-hidden="true"><b>AEP</b></span>
          </div>
          <div class="card-body">
            <h3>Traslado a Aeroparque</h3>
            <p>Viajes rápidos a Aeroparque Jorge Newbery para vuelos de cabotaje y regionales, y conexión directa con Ezeiza.</p>
            <a href={url('/traslados-aeroparque/')}>Ver traslados a Aeroparque <span class="arr" aria-hidden="true"><Icon name="arrow-right" /></span></a>
          </div>
        </article>
        <article class="card reveal">
          <div class="card-media">
            <Image src={vanRampa} alt="Pasajero en silla de ruedas dentro de la van, subido por la rampa" widths={[430]} sizes="(max-width: 900px) 100vw, 370px" />
            <span class="tag" aria-hidden="true"><Icon name="wheelchair" /></span>
          </div>
          <div class="card-body">
            <h3>Traslado en silla de ruedas</h3>
            <p>La misma van tiene rampa para personas con movilidad reducida. Subís en tu silla, con acompañante y equipaje.</p>
            <a href={url('/traslados-silla-de-ruedas/')}>Ver traslados accesibles <span class="arr" aria-hidden="true"><Icon name="arrow-right" /></span></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="zonas" aria-labelledby="zonas-title" style="padding-top:0">
    <div class="wrap" style="display:grid;gap:20px">
      <div class="section-head reveal" style="margin:0">
        <span class="eyebrow">Zonas</span>
        <h2 id="zonas-title">¿Desde dónde salís?</h2>
        <p class="lead">Te buscamos en cualquier barrio de Capital Federal (Palermo, Recoleta, Belgrano, Caballito, Microcentro, Puerto Madero y todos los demás) y en el Gran Buenos Aires.</p>
      </div>
      <nav class="related reveal" aria-label="Traslados por zona">
        <ul>
          {ZONE_PAGES.map((z) => <li><a href={url(z.path)}>Traslados desde {z.name}</a></li>)}
          <li><a href={url('/traslado-ezeiza-aeroparque/')}>Conexión Ezeiza – Aeroparque</a></li>
        </ul>
      </nav>
    </div>
  </section>

  <section class="access-band section" aria-labelledby="accesible-title">
    <div class="wrap split">
      <div class="split-media media-blue reveal">
        <Image src={rampa} alt="Chofer ayudando a un pasajero en silla de ruedas a subir a la van por la rampa" widths={[553]} sizes="(max-width: 860px) 100vw, 540px" />
        <div class="float-label float-br" aria-hidden="true"><span class="tile"><Icon name="wheelchair" /></span><b>Rampa de acceso</b></div>
      </div>
      <div class="split-copy reveal">
        <span class="isa" aria-hidden="true"><Icon name="wheelchair" /></span>
        <h2 id="accesible-title">Adaptado para personas con discapacidad</h2>
        <p class="lead">Viajar al aeropuerto en silla de ruedas no tiene que ser complicado. Nuestra van tiene rampa y espacio para que la persona viaje cómoda y segura.</p>
        <ul class="ticks">
          <li><span class="tile" aria-hidden="true"><Icon name="check" /></span><p><b>Rampa de acceso.</b> <span>La persona sube y baja sin dejar su silla de ruedas.</span></p></li>
          <li><span class="tile" aria-hidden="true"><Icon name="check" /></span><p><b>Ayuda del chofer.</b> <span>Te asistimos al subir, al bajar y con el equipaje.</span></p></li>
          <li><span class="tile" aria-hidden="true"><Icon name="check" /></span><p><b>Lugar para acompañantes.</b> <span>La familia viaja junta en el mismo vehículo.</span></p></li>
        </ul>
        <p><a href={url('/guia/viajar-en-avion-en-silla-de-ruedas/')}>Guía: cómo viajar en avión en silla de ruedas</a></p>
        <div><a class="btn btn-wa" href={waLink('Hola! Necesito un traslado al aeropuerto para una persona en silla de ruedas.')} rel="noopener" target="_blank"><Icon name="whatsapp" /> Consultar traslado accesible</a></div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="van-title">
    <div class="wrap split reverse">
      <div class="split-media media-green reveal">
        <Image src={equipaje} alt="Valijas de colores listas para el viaje en la playa" widths={[640, 1000, 1400]} sizes="(max-width: 860px) 100vw, 540px" />
        <div class="float-label float-tl" aria-hidden="true"><span class="tile"><Icon name="luggage" /></span><b>Todo tu equipaje</b></div>
      </div>
      <div class="split-copy reveal">
        <span class="eyebrow">Van espaciosa</span>
        <h2 id="van-title">Especial para pasajeros con mucho equipaje</h2>
        <p class="lead">Familias, grupos y viajeros con valijas grandes viajan juntos en un solo vehículo, sin tener que pedir dos autos.</p>
        <ul class="ticks tint-green">
          <li><span class="tile" aria-hidden="true"><Icon name="shield" /></span><p><b>Confort y seguridad.</b> <span>Van limpia y chofer responsable.</span></p></li>
          <li><span class="tile" aria-hidden="true"><Icon name="clock" /></span><p><b>Puntualidad.</b> <span>Responsabilidad, llegás a tiempo a tu vuelo.</span></p></li>
          <li><span class="tile" aria-hidden="true"><Icon name="luggage" /></span><p><b>Todo tu equipaje.</b> <span>Valijas, cochecitos y bolsos en la misma van.</span></p></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section steps-band" aria-labelledby="pasos-title">
    <div class="wrap">
      <div class="section-head center reveal">
        <span class="eyebrow">Cómo reservar</span>
        <h2 id="pasos-title">Tu traslado listo en tres pasos</h2>
      </div>
      <ol class="steps">
        <li class="reveal"><span class="step-num" aria-hidden="true">01</span><span class="tile" aria-hidden="true"><Icon name="chat" /></span><h3>Escribinos</h3><p>Mandanos por WhatsApp la fecha, el horario, la dirección y cuántos viajan.</p></li>
        <li class="reveal"><span class="step-num" aria-hidden="true">02</span><span class="tile" aria-hidden="true"><Icon name="check" /></span><h3>Confirmamos</h3><p>Te pasamos el precio y te reservamos la van.</p></li>
        <li class="reveal"><span class="step-num" aria-hidden="true">03</span><span class="tile" aria-hidden="true"><Icon name="plane" /></span><h3>Viajás tranquilo</h3><p>El chofer te espera a la hora pactada y te lleva puerta a puerta.</p></li>
      </ol>
    </div>
  </section>

  <section class="section" id="reservar" aria-labelledby="reservar-title">
    <div class="wrap"><BookingForm /></div>
  </section>

  <section class="section" id="preguntas" aria-labelledby="faq-title" style="padding-top:0">
    <div class="wrap">
      <Faq items={faqs}>
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2 id="faq-title">Lo que más nos consultan</h2>
      </Faq>
    </div>
  </section>
</Base>
